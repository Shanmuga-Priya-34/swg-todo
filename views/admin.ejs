<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Arial, sans-serif;
            background:#f4f6f9;
            padding:25px;
            color:#222;
        }

        .topbar{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:30px;
        }

        h1{
            font-size:42px;
            font-weight:bold;
        }

        .btn{
            background:#007bff;
            color:white;
            text-decoration:none;
            padding:12px 18px;
            border-radius:10px;
            font-size:15px;
            transition:0.2s;
        }

        .btn:hover{
            background:#005fd1;
        }

        .grid{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
            gap:20px;
            margin-bottom:35px;
        }

        .card{
            background:white;
            padding:24px;
            border-radius:18px;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
            transition:0.2s;
        }

        .card:hover{
            transform:translateY(-4px);
        }

        .card h2{
            font-size:20px;
            margin-bottom:16px;
            color:#555;
        }

        .card p{
            font-size:42px;
            font-weight:bold;
            color:#111;
        }

        .chart-wrapper{
            background:white;
            padding:25px;
            border-radius:18px;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
            margin-bottom:35px;
        }

        .chart-wrapper h2{
            margin-bottom:20px;
        }

        #taskChart{
            width:100% !important;
            height:400px !important;
        }

        .logs{
            background:white;
            padding:25px;
            border-radius:18px;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
            overflow-x:auto;
        }

        .logs h2{
            margin-bottom:20px;
        }

        table{
            width:100%;
            border-collapse:collapse;
        }

        table th{
            background:#f2f2f2;
            padding:15px;
            text-align:left;
        }

        table td{
            padding:15px;
            border-bottom:1px solid #ddd;
        }

        table tr:hover{
            background:#fafafa;
        }

        .danger{
            color:#dc3545;
            font-weight:bold;
        }

        .warning{
            color:#ff9800;
            font-weight:bold;
        }

        .success{
            color:#28a745;
            font-weight:bold;
        }

    </style>

</head>

<body>

    <div class="topbar">

        <h1>
            Welcome Admin, <%= username %>
        </h1>

        <a href="/dashboard" class="btn">
            Back
        </a>

    </div>

    <div class="grid">

        <div class="card">
            <h2>Total Users</h2>
            <p><%= totalUsers %></p>
        </div>

        <div class="card">
            <h2>Total Admins</h2>
            <p><%= totalAdmins %></p>
        </div>

        <div class="card">
            <h2>Total Tasks</h2>
            <p><%= totalTasks %></p>
        </div>

        <div class="card">
            <h2>Completed Tasks</h2>
            <p><%= completedTasks %></p>
        </div>

        <div class="card">
            <h2>Pending Tasks</h2>
            <p><%= pendingTasks %></p>
        </div>

        <div class="card">
            <h2>Failed Logins</h2>
            <p><%= failedLogins %></p>
        </div>

        <div class="card">
            <h2>OTP Failures</h2>
            <p><%= otpFailures %></p>
        </div>

        <div class="card">
            <h2>Unauthorized Attempts</h2>
            <p><%= unauthorizedAttempts %></p>
        </div>

    </div>

    <div class="chart-wrapper">

        <h2>Task Analytics</h2>

        <canvas id="taskChart"></canvas>

    </div>

    <div class="logs">

        <h2>Recent Security Logs</h2>

        <table>

            <tr>
                <th>Username</th>
                <th>Action</th>
                <th>IP Address</th>
                <th>Timestamp</th>
            </tr>

            <% logs.forEach(log => { %>

                <tr>

                    <td>
                        <%= log.username %>
                    </td>

                    <td class="
                        <%= 
                            log.action.includes('Failed')
                            || log.action.includes('Unauthorized')
                            || log.action.includes('Invalid')
                            ? 'danger'
                            : log.action.includes('OTP')
                            ? 'warning'
                            : 'success'
                        %>
                    ">

                        <%= log.action %>

                    </td>

                    <td>
                        <%= log.ip %>
                    </td>

                    <td>
                        <%= log.timestamp %>
                    </td>

                </tr>

            <% }) %>

        </table>

    </div>

<script>

const ctx = document.getElementById("taskChart");

new Chart(ctx, {

    type: "bar",

    data: {

        labels: [
            "Completed Tasks",
            "Pending Tasks",
            "Failed Logins",
            "OTP Failures",
            "Unauthorized Attempts"
        ],

        datasets: [{

            label: "Admin Analytics",

            data: [
                <%= completedTasks %>,
                <%= pendingTasks %>,
                <%= failedLogins %>,
                <%= otpFailures %>,
                <%= unauthorizedAttempts %>
            ],

            borderWidth: 1

        }]

    },

    options: {

        responsive: true,

        maintainAspectRatio: false,

        scales: {

            y: {
                beginAtZero: true
            }

        }

    }

});

</script>

</body>

</html>