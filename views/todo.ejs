<!DOCTYPE html>
<html>
<head>
    <title>To-Do List</title>
</head>
<body>
    <h1><%= username %>'s To-Do List</h1>
    <form method="POST" action="/todo">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="content" placeholder="New Task" required>
        <button type="submit">Add</button>
    </form>
    <ul>
    <% tasks.forEach(task => { %>
        <li>
            <form method="POST" action="/task/<%= task.id %>/toggle" class="toggle-task-form" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit"><%= task.completed ? "Undo" : "Complete" %></button>
            </form>
            <%= task.content %> (<%= task.completed ? "Done" : "Pending" %>)
            <form method="POST" action="/task/<%= task.id %>/delete" class="delete-task-form" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit">Delete</button>
            </form>
        </li>
    <% }) %>
    </ul>
    <a href="/dashboard">Back to Dashboard</a><br>
    <a href="/logout">Logout</a>
    <script src="/script.js"></script>
</body>
</html>
